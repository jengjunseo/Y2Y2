# Y2Y2 v0.4 relay environment
# Install-free Web backend (VideoScale free account; no paid plan required).
# Keep these server-side in Vercel Preview/Production Secret variables.
Y2Y2_VIDEO_API_USER=
Y2Y2_VIDEO_API_PASSWORD=
# Separate private-site password, at least 16 characters. Do not reuse an account password.
Y2Y2_WEB_PASSWORD=

# Required only for Home Engine relay; Local Engine works without these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
Y2Y2_RELAY_OWNER_SECRET=
# Required for Relay result files. Connecting a Vercel Private Blob store injects this.
BLOB_READ_WRITE_TOKEN=
# Optional conservative overrides:
# Y2Y2_RELAY_CREATE_PER_MINUTE=30
# Y2Y2_RELAY_ITEMS_PER_DAY=1000
# Y2Y2_RELAY_TTL_MS=3600000
