# Y2Y2 v0.4 relay environment
# Required only for Home Engine relay; Local Engine works without these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
Y2Y2_RELAY_OWNER_SECRET=
# Required for Relay result files. Connecting a Vercel Private Blob store injects this.
BLOB_READ_WRITE_TOKEN=
# Optional conservative overrides:
# Y2Y2_RELAY_CREATE_PER_MINUTE=30
# Y2Y2_RELAY_ITEMS_PER_DAY=1000
# Y2Y2_RELAY_TTL_MS=3600000
